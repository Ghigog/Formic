{
  "name": "formic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "bash scripts/db-push.sh && node scripts/build-portraits.mjs && node scripts/build-loop-entry.mjs && next build",
    "build:portraits": "node scripts/build-portraits.mjs",
    "build:loop-entry": "node scripts/build-loop-entry.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project node",
    "test:dom": "vitest run --project dom",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "./scripts/local-db.sh",
    "db:backup": "./scripts/backup.sh",
    "db:restore": "./scripts/restore.sh",
    "serve": "./scripts/serve.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@e2b/code-interpreter": "^2.8.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "libsodium-wrappers": "0.8.4",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
