# Postgres connection string. Supabase, Neon, or local.
DATABASE_URL="postgresql://user:password@localhost:5432/formic"

# Local mode only: lets columns without an agent template run Claude in
# development. Signed in with GitHub, keys live on each agent template.
ANTHROPIC_API_KEY=""

# Sign in with GitHub. Set all three from your GitHub App's settings page and
# everyone signs in with GitHub; agents act with each person's own access.
# Leave them empty for local mode: one user, no sign-in. See README.md.
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_SLUG=""

# Encrypts saved tokens and keys, and signs sessions. `openssl rand -base64 32`.
# Changing it signs everyone out and makes saved keys unreadable.
FORMIC_SECRET=""

# Optional. The board's public address. CLI agents in GitHub Actions post what
# they are doing here as they work, and pick up notes. On Vercel, the
# production address is used when this is empty.
FORMIC_URL=""

# Optional. Comma-separated GitHub usernames allowed to sign in.
FORMIC_ALLOWED_USERS=""

# Local mode only: the GitHub credential for cloning and pushing, and an
# optional shared password. Ignored once the GitHub App is configured.
# CLI agents also need the token to have the "workflow" scope.
GITHUB_TOKEN=""
FORMIC_PASSWORD=""

# The default board's repository in local mode, as "owner/repo".
GITHUB_REPO=""

# Base branch agents branch from and merge into.
GITHUB_BASE_BRANCH="main"

# Optional fallback E2B key, as above. People add their own in Settings.
E2B_API_KEY=""

# Sandbox provider: "e2b" or "local".
SANDBOX_PROVIDER="local"

# The GitHub App's webhook secret, for /api/webhooks/github. Without it the
# endpoint refuses every delivery rather than trusting an unsigned one.
GITHUB_WEBHOOK_SECRET=""

# Where agents merge once the Reviewer Agent approves and CI is green. "base"
# is each project's own base branch, so a Done ticket's code is there.
# "integration" holds agent work on formic/integration until a person
# promotes it to the base branch.
MERGE_TARGET="base"

# Optional. A Slack (or other JSON-body) incoming webhook URL. Without it,
# error spikes just log a warning instead of paging anyone. Also set as the
# ALERT_WEBHOOK_URL secret on the smoke-test workflow (.github/workflows/
# smoke-test.yml) so a failed deploy or ok: false alerts the same way.
ALERT_WEBHOOK_URL=""
