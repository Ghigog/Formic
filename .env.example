# Postgres connection string. Supabase, Neon, or local.
DATABASE_URL="postgresql://user:password@localhost:5432/formic"

# Anthropic API key for the agent pipelines.
ANTHROPIC_API_KEY=""

# GitHub credential for cloning and pushing. Prefer a GitHub App installation
# token over a classic PAT: short-lived and repository-scoped. See
# docs/tasks/PROT-11-secrets.md.
GITHUB_TOKEN=""

# The single repository the MVP operates against, as "owner/repo".
GITHUB_REPO=""

# Base branch agents branch from and merge into.
GITHUB_BASE_BRANCH="main"

# E2B API key. Leave empty to use the local sandbox provider.
E2B_API_KEY=""

# Sandbox provider: "e2b" or "local".
SANDBOX_PROVIDER="local"
