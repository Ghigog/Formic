generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  draft
  specified
  ready
  waiting
  running
  review
  merged
  blocked
  failed
}

enum ColumnId {
  backlog
  todo
  in_progress
  in_review
  done
}

enum AgentRole {
  product
  architect
  coder
  reviewer
  pm
}

enum AgentRunStatus {
  queued
  running
  succeeded
  failed
  blocked
  cancelled
}

enum TicketSize {
  S
  M
  L
  XL
}

/// A person, signed in with GitHub. Their tokens and keys are sealed with
/// FORMIC_SECRET; see src/lib/secrets/vault.ts.
model User {
  id        String  @id @default(cuid())
  githubId  Int     @unique
  login     String
  name      String?
  avatarUrl String?

  /// GitHub App user-to-server token, and the refresh token behind it.
  githubTokenCipher      String?
  githubTokenExpiresAt   DateTime?
  githubRefreshCipher    String?
  githubRefreshExpiresAt DateTime?

  e2bKeyCipher       String?
  e2bKeyHint         String?
  anthropicKeyCipher String?
  anthropicKeyHint   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  presets  AgentPreset[]

  @@map("user")
}

model Project {
  id           String   @id @default(cuid())
  /// Null for the demo board, which belongs to no one.
  ownerId      String?
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  repoFullName String
  baseBranch   String   @default("main")
  createdAt    DateTime @default(now())

  epics        Epic[]
  events       Event[]
  columnAgents ColumnAgent[]

  @@index([ownerId])
  @@map("project")
}

model Epic {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title            String
  rawRequest       String
  /// Structured PRD from the Product Agent. Null until stage 2 completes.
  prd              Json?
  prdEditedByHuman Boolean @default(false)
  showcase         String?
  /// The GitHub Actions run a CLI agent is doing for this epic, if any.
  /// Only that run's answer is taken; any other is stale.
  runnerJob        String?

  status    TicketStatus @default(draft)
  /// Set only for blocked/failed cards, so a stalled card keeps its column.
  stalledIn ColumnId?
  stage     Int          @default(1)
  /// Fractional index. A drag writes one row instead of renumbering a column.
  position  Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
  runs    AgentRun[]

  @@index([projectId, status])
  @@map("epic")
}

model Ticket {
  id     String @id @default(cuid())
  epicId String
  epic   Epic   @relation(fields: [epicId], references: [id], onDelete: Cascade)

  key                String
  title              String
  description        String
  acceptanceCriteria String[]
  /// Normalised directory prefixes. The concurrency boundary.
  fileScope          String[]
  size               TicketSize @default(M)

  status    TicketStatus @default(waiting)
  stalledIn ColumnId?
  stage     Int          @default(3)
  position  Float
  /// Pulled out of its epic's group by a human. Only To Do reads it.
  detached  Boolean      @default(false)

  branchName    String?
  /// One line describing what the Coder Agent actually changed. Feeds the
  /// Epic showcase, which would otherwise only know ticket titles.
  summary       String?
  prNumber      Int?
  prUrl         String?
  blockedReason String?
  attempts      Int     @default(0)
  /// The GitHub Actions run a CLI agent is doing for this ticket, if any.
  /// Only that run's result is taken; any other is stale.
  runnerJob     String?

  costCents Float @default(0)
  tokensIn  Int   @default(0)
  tokensOut Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dependsOn  TicketDependency[] @relation("dependent")
  dependents TicketDependency[] @relation("dependency")
  runs       AgentRun[]

  @@unique([epicId, key])
  @@index([epicId, status])
  @@index([prNumber])
  @@map("ticket")
}

model TicketDependency {
  ticketId          String
  ticket            Ticket @relation("dependent", fields: [ticketId], references: [id], onDelete: Cascade)
  dependsOnTicketId String
  dependsOn         Ticket @relation("dependency", fields: [dependsOnTicketId], references: [id], onDelete: Cascade)

  @@id([ticketId, dependsOnTicketId])
  @@index([dependsOnTicketId])
  @@map("ticket_dependency")
}

model AgentRun {
  id   String    @id @default(cuid())
  role AgentRole

  epicId String?
  epic   Epic?   @relation(fields: [epicId], references: [id], onDelete: Cascade)

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  status AgentRunStatus @default(queued)
  model  String?

  tokensIn  Int   @default(0)
  tokensOut Int   @default(0)
  costCents Float @default(0)

  sandboxId String?
  error     String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([ticketId])
  @@map("agent_run")
}

/// Webhook deliveries already handled, keyed on the delivery id and on
/// (pull request, head sha, check). GitHub delivers at least once and out of
/// order, so this table is what stops a redelivery becoming a second fix
/// commit. See docs/tasks/PROT-07-reviewer-agent.md.
model WebhookDelivery {
  key        String   @id
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("webhook_delivery")
}

/// Append-only event log. Backs SSE replay: a reconnecting client asks for
/// everything after the last `seq` it saw rather than showing a gap.
model Event {
  seq       BigInt   @id @default(autoincrement())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  at        DateTime @default(now())

  @@index([projectId, seq])
  @@map("event")
}

/// A saved agent: a model, a brief, and optionally its own API key. Saved
/// once and assigned to columns on any project's board.
model AgentPreset {
  id           String   @id @default(cuid())
  /// Null for presets saved before accounts existed.
  ownerId      String?
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  provider     String   @default("anthropic")
  model        String
  /// Replaces the built-in brief for whichever column runs it.
  prompt       String
  /// AES-GCM ciphertext. Null means the server's ANTHROPIC_API_KEY.
  apiKeyCipher String?
  /// Last four characters, so the editor can say which key is saved.
  apiKeyHint   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  columns ColumnAgent[]

  @@index([ownerId])
  @@map("agent_preset")
}

/// Which preset runs a column's agent on one project's board.
model ColumnAgent {
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column    ColumnId
  presetId  String
  preset    AgentPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@id([projectId, column])
  @@index([presetId])
  @@map("column_agent")
}
